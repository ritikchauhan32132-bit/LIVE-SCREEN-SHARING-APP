# RITIK SC Backend Configuration

PORT=8080
NODE_ENV=development

# Firebase Admin SDK Configuration
# Provide either path to service account JSON or individual fields
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=ritik-sc-remoteaccess

# Coturn / TURN Server Configuration (RFC 5766 REST API)
# Replace with your actual TURN server details in production
TURN_SERVER_URL=turn:turn.ritiksc.com:3478
TURN_SERVER_SECRET=your_coturn_static_auth_secret_here
TURN_CREDENTIAL_TTL_SECONDS=86400

# Rate Limiting
MAX_PAIRING_REQUESTS_PER_WINDOW=5
PAIRING_WINDOW_SECONDS=900
